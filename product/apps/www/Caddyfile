{
	# TLS is terminated in front of this container.
	auto_https off
	admin off
}

:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	@hashed path /_astro/* /fonts/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@pages not path /_astro/* /fonts/*
	header @pages Cache-Control "public, max-age=300"

	# /pt and /es resolve to their index.html; unknown paths get the 404 page.
	handle_errors {
		rewrite * /404.html
		file_server
	}
	file_server
}
