---
import type { Copy } from "../i18n/copy";
import { CHANGELOG_URL, DASHBOARD_URL, DOCS_URL, PRICING_URL } from "../site";
import Logo from "./Logo.astro";

type Props = {
  copy: Copy["nav"];
  homeHref: string;
};

const { copy, homeHref } = Astro.props;

const NAV_LINKS = [
  { href: DOCS_URL, label: copy.docs },
  { href: PRICING_URL, label: copy.pricing },
  { href: CHANGELOG_URL, label: copy.changelog },
];
---

<header class="flex items-center justify-between gap-6 py-5">
  <div class="flex items-center gap-8">
    <Logo href={homeHref} label={copy.home} />
    <nav class="hidden items-center gap-1 md:flex" aria-label={copy.primary}>
      {
        NAV_LINKS.map((link) => (
          <a
            class="rounded-full px-3 py-1.5 text-[15px] text-muted-foreground transition-colors duration-150 hover:text-foreground"
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="flex items-center gap-2">
    <a class="pill pill--outline pill--small" href={DASHBOARD_URL}>{copy.dashboard}</a>
    <details class="site-menu md:hidden" data-site-menu>
      <summary class="site-menu__toggle" aria-label={copy.menu}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 7h14M3 13h14"></path></svg>
      </summary>
      <nav class="site-menu__panel" aria-label={copy.primary}>
        {NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>("[data-site-menu]");
  if (menu) {
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) menu.open = false;
    });
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") menu.open = false;
    });
  }
</script>
