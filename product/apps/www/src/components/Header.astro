---
import type { Copy } from "../i18n/copy";
import type { Locale } from "../i18n/locales";
import { LOCALE_HREFLANG, LOCALES, localeHomePath } from "../i18n/locales";
import { DASHBOARD_URL, docsUrl } from "../site";
import Logo from "./Logo.astro";

type Props = {
  copy: Copy["nav"];
  locale: Locale;
};

const { copy, locale } = Astro.props;

const NAV_LINKS = [
  { href: "#demo", label: copy.demo },
  { href: "#e2b", label: copy.e2b },
  { href: "#pix", label: copy.pix },
];
---

<header class="nav" data-nav>
  <div class="wrap nav__row">
    <Logo href={localeHomePath(locale)} label={copy.home} />
    <nav class="nav__links" aria-label={copy.primary}>
      {NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
      <a class="nav__docs" href={docsUrl(locale)} rel="noopener">{copy.docs}</a>
    </nav>
    <div class="nav__actions">
      <nav class="langs" aria-label={copy.languages} data-langs>
        {
          LOCALES.map((item) => (
            <a
              href={localeHomePath(item)}
              hreflang={LOCALE_HREFLANG[item]}
              lang={item}
              aria-current={item === locale ? "page" : undefined}
            >
              {item.toUpperCase()}
            </a>
          ))
        }
      </nav>
      <a class="nav__signin" href={DASHBOARD_URL}>{copy.signIn}</a>
      <a class="btn btn--accent nav__join" href="#waitlist" data-join>{copy.join}</a>
    </div>
  </div>
</header>
