---
import { getCopy } from "../i18n/copy";
import type { Locale } from "../i18n/locales";
import { DEFAULT_LOCALE, isLocale, localeHomePath } from "../i18n/locales";
import { rich } from "../i18n/rich";
import BaseLayout from "../layouts/BaseLayout.astro";
import { DASHBOARD_URL, DOCS_URL, SDK_DOMAIN } from "../site";
import { buildE2bSnippets, buildSessions } from "../snippets";
import { E2bSnippet } from "./E2bSnippet";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import { SessionDemo } from "./SessionDemo";

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const copy = getCopy(locale);
const { hero, demo, features, e2b, lifecycle, cta } = copy;
const sessions = buildSessions(SDK_DOMAIN, demo.session);
const e2bSnippets = buildE2bSnippets(SDK_DOMAIN);

const ICONS = [
  // Own kernel
  '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 9h6v6H9z"/>',
  // Suspend
  '<circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/>',
  // Fork
  '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="19" r="2.5"/><path d="M6 8.5v1.5a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3V8.5M12 13v3.5"/>',
  // Port
  '<circle cx="12" cy="12" r="8"/><path d="M4 12h16M12 4c3 3 3 13 0 16M12 4c-3 3-3 13 0 16"/>',
  // Exec
  '<path d="M5 7l5 5-5 5M12 18h7"/>',
  // Desktop
  '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
];
const LIFECYCLE_BARS = [100, 60, 50, 75];
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  locale={locale}
  skipLabel={copy.meta.skipToContent}
  imageAlt={copy.meta.ogAlt}
>
  <Header copy={copy.nav} homeHref={localeHomePath(locale)} />

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero__wrap">
        <div class="hero__copy">
          <p class="eyebrow">{hero.eyebrow}</p>
          <h1 id="hero-title" class="hd">{hero.title}</h1>
          <p class="lead">{hero.lead}</p>
          <div class="ctas">
            <a class="btn btn--pri" href={DASHBOARD_URL}>{hero.start}</a>
            <a class="btn" href="#how">{hero.watch}</a>
          </div>
          <p class="hero__facts">{hero.facts}</p>
        </div>
      </div>
    </section>

    <section class="sec sec--alt" id="how" aria-labelledby="how-title">
      <div class="wrap">
        <div class="shead">
          <p class="eyebrow">{demo.eyebrow}</p>
          <h2 id="how-title" class="sh">{demo.title}</h2>
          <p class="lead">{demo.lead}</p>
        </div>
        <SessionDemo
          client:visible
          sessions={sessions}
          steps={demo.steps}
          languageLabel={demo.languageLabel}
          terminalLabel={demo.terminalLabel}
        />
        <p class="fine demo-note">{demo.note}</p>
      </div>
    </section>

    <section class="sec" id="features" aria-labelledby="features-title">
      <div class="wrap">
        <div class="shead">
          <p class="eyebrow">{features.eyebrow}</p>
          <h2 id="features-title" class="sh">{features.title}</h2>
        </div>
        <div class="cards">
          {
            features.items.map((item, i) => (
              <article class="card">
                <div class="ico">
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={ICONS[i]}
                  />
                </div>
                <h3>{item.title}</h3>
                <p set:html={rich(item.body)} />
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="sec sec--alt" id="e2b" aria-labelledby="e2b-title">
      <div class="wrap">
        <div class="env">
          <div>
            <p class="eyebrow">{e2b.eyebrow}</p>
            <h2 id="e2b-title" class="sh">{e2b.title}</h2>
            <p class="lead">{e2b.lead}</p>
            <p class="fine env__note" set:html={rich(e2b.envLine)} />
            <p class="fine env__note">{e2b.keyLine} <a class="env__link" href={DASHBOARD_URL}>{e2b.keyLink}</a></p>
          </div>
          <E2bSnippet
            client:visible
            snippets={e2bSnippets}
            languageLabel={e2b.languageLabel}
            before={e2b.before}
            after={e2b.after}
          />
        </div>
      </div>
    </section>

    <section class="sec" id="lifecycle" aria-labelledby="lifecycle-title">
      <div class="wrap">
        <div class="shead">
          <p class="eyebrow">{lifecycle.eyebrow}</p>
          <h2 id="lifecycle-title" class="sh">{lifecycle.title}</h2>
          <p class="lead">{lifecycle.lead}</p>
        </div>
        <div class="lc">
          {
            lifecycle.cards.map((card, i) => (
              <article class="lcc">
                <span class="lcc__t">{card.value}</span>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
                <div class="bar" aria-hidden="true">
                  <span style={`width:${LIFECYCLE_BARS[i]}%`} />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="sec sec--cta" id="start" aria-labelledby="cta-title">
      <div class="wrap">
        <div class="cta">
          <p class="cta__eyebrow">{cta.eyebrow}</p>
          <h2 id="cta-title" class="sh">{cta.title}</h2>
          <p set:html={rich(cta.lead)} />
          <div class="cta__actions">
            <a class="btn btn--accent" href={DASHBOARD_URL}>{cta.start}</a>
            <a class="btn btn--ghost" href={DOCS_URL}>{cta.docs}</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} copy={copy} />
</BaseLayout>
