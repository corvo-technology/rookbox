---
import { getCopy } from "../i18n/copy";
import type { Locale } from "../i18n/locales";
import { DEFAULT_LOCALE, isLocale } from "../i18n/locales";
import BaseLayout from "../layouts/BaseLayout.astro";
import { E2B_API_URL, SDK_DOMAIN } from "../site";
import { buildE2bSnippets, buildSessions } from "../snippets";
import { E2bSnippet } from "./E2bSnippet";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Rook from "./Rook.astro";
import { SessionDemo } from "./SessionDemo";
import WaitlistForm from "./WaitlistForm.astro";

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const copy = getCopy(locale);
const { hero, visual, brazil, demo, e2b, cta, waitlist } = copy;
const sessions = buildSessions(SDK_DOMAIN, demo.session);
const e2bSnippets = buildE2bSnippets(E2B_API_URL);
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  locale={locale}
  skipLabel={copy.meta.skipToContent}
  imageAlt={copy.meta.ogAlt}
>
  <Header copy={copy.nav} locale={locale} />

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero__wrap">
        <div class="hero__copy">
          <h1 id="hero-title" class="hd hero__in" style="--i:0">{hero.title}</h1>
          <p class="hero__lead hero__in" style="--i:1">{hero.lead}</p>
          <div class="hero__form hero__in" id="waitlist" style="--i:2">
            <WaitlistForm copy={waitlist} locale={locale} id="hero" tone="dark" />
          </div>
        </div>
        <div class="hero__visual hero__in" style="--i:1">
          <Rook copy={visual} />
        </div>
      </div>
    </section>

    <section class="sec sec--demo" id="demo" aria-labelledby="demo-title">
      <div class="wrap">
        <h2 id="demo-title" class="sh" data-reveal>{demo.title}</h2>
        <div class="demo-wrap" data-reveal>
          <SessionDemo
            client:visible
            sessions={sessions}
            steps={demo.steps}
            languageLabel={demo.languageLabel}
            terminalLabel={demo.terminalLabel}
          />
        </div>
        <ul class="facts" data-reveal>
          {demo.facts.map((fact) => <li>{fact}</li>)}
        </ul>
      </div>
    </section>

    <section class="sec sec--e2b" id="e2b" aria-labelledby="e2b-title">
      <div class="wrap">
        <h2 id="e2b-title" class="sh" data-reveal>{e2b.title}</h2>
        <div class="e2b-wrap" data-reveal>
          <E2bSnippet
            client:visible
            snippets={e2bSnippets}
            languageLabel={e2b.languageLabel}
            before={e2b.before}
            after={e2b.after}
            code={e2b.code}
          />
        </div>
      </div>
    </section>

    <section class="sec sec--pix" id="pix" aria-labelledby="pix-title">
      <div class="wrap pix-wrap" data-reveal>
        <p class="pix">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.5 21.5 12 12 21.5 2.5 12Z"></path>
            <path d="M12 8 16 12 12 16 8 12Z"></path>
          </svg>
          {brazil.badge}
        </p>
        <h2 id="pix-title" class="sh">{brazil.title}</h2>
        <p class="pix__lead">{brazil.lead}</p>
      </div>
    </section>

    <section class="sec sec--cta" aria-labelledby="cta-title">
      <div class="wrap cta" data-reveal>
        <h2 id="cta-title" class="sh">{cta.title}</h2>
        <div class="cta__form">
          <WaitlistForm copy={waitlist} locale={locale} id="cta" />
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} copy={copy} />
</BaseLayout>
