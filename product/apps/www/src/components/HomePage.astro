---
import { getCopy } from "../i18n/copy";
import type { Locale } from "../i18n/locales";
import { DEFAULT_LOCALE, isLocale, LOCALE_HTML_LANG, localeHomePath } from "../i18n/locales";
import { rich } from "../i18n/rich";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT_URL, DOCS_URL, MACHINES_URL, API_KEYS_URL } from "../site";
import { ENV_AFTER, ENV_BEFORE, buildSessions } from "../snippets";
import { FLEET_ENDPOINT, FREE_CREDIT_OFFER, PLANS } from "../placeholders";
import { EnvToggle } from "./EnvToggle";
import { FleetCounter } from "./FleetCounter";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import { SessionDemo } from "./SessionDemo";

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const copy = getCopy(locale);
const { hero, demo, features, e2b, lifecycle, pricing, cta } = copy;
const sessions = buildSessions(demo.session);

const ICONS = [
  // Own kernel
  '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 9h6v6H9z"/>',
  // Suspend
  '<circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/>',
  // Fork
  '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="19" r="2.5"/><path d="M6 8.5v1.5a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3V8.5M12 13v3.5"/>',
  // Port
  '<circle cx="12" cy="12" r="8"/><path d="M4 12h16M12 4c3 3 3 13 0 16M12 4c-3 3-3 13 0 16"/>',
  // Exec
  '<path d="M5 7l5 5-5 5M12 18h7"/>',
  // Desktop
  '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
];
const LIFECYCLE_BARS = [100, 60, 50, 75];
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  locale={locale}
  skipLabel={copy.meta.skipToContent}
>
  <Header copy={copy.nav} homeHref={localeHomePath(locale)} />

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero__wrap">
          <FleetCounter
            client:visible
            locale={LOCALE_HTML_LANG[locale]}
            label={hero.counter.label}
            demo={hero.counter.demo}
            aria={hero.counter.aria}
            note={`${hero.counter.note} ${FLEET_ENDPOINT}`}
          />
        <div class="hero__copy">
          <p class="eyebrow">{hero.eyebrow}</p>
          <h1 id="hero-title" class="hd">{hero.title}</h1>
          <p class="lead">{hero.lead}</p>
          <div class="ctas">
            <a class="btn btn--pri" href={MACHINES_URL}>{hero.start}</a>
            <a class="btn" href="#demo">{hero.watch}</a>
          </div>
          <p class="fine">{hero.fine} {FREE_CREDIT_OFFER}</p>
        </div>
      </div>
    </section>

    <section class="sec sec--alt" id="demo" aria-labelledby="demo-title">
      <div class="wrap">
        <div class="shead">
          <p class="eyebrow">{demo.eyebrow}</p>
          <h2 id="demo-title" class="sh">{demo.title}</h2>
          <p class="lead">{demo.lead}</p>
        </div>
        <SessionDemo
          client:visible
          sessions={sessions}
          steps={demo.steps}
          languageLabel={demo.languageLabel}
          terminalLabel={demo.terminalLabel}
          cliLabel={demo.cli}
        />
        <p class="fine demo-note">{demo.note}</p>
      </div>
    </section>

    <section class="sec" id="features" aria-labelledby="features-title">
      <div class="wrap">
        <div class="shead">
          <p class="eyebrow">{features.eyebrow}</p>
          <h2 id="features-title" class="sh">{features.title}</h2>
        </div>
        <div class="cards">
          {
            features.items.map((item, i) => (
              <article class="card">
                <div class="ico">
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={ICONS[i]}
                  />
                </div>
                <h3>
                  {item.title}
                  {i === features.items.length - 1 && <span class="soon">{features.soon}</span>}
                </h3>
                <p set:html={rich(item.body)} />
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="sec sec--alt" id="e2b" aria-labelledby="e2b-title">
      <div class="wrap">
        <EnvToggle
          client:visible
          toggleLabel={e2b.toggleLabel}
          before={e2b.before}
          after={e2b.after}
          beforeHint={e2b.beforeHint}
          unchanged={e2b.unchanged}
          envBefore={ENV_BEFORE}
          envAfter={ENV_AFTER}
        >
          <p class="eyebrow">{e2b.eyebrow}</p>
          <h2 id="e2b-title" class="sh">{e2b.title}</h2>
          <p class="lead" set:html={rich(e2b.lead)} />
        </EnvToggle>
      </div>
    </section>

    <section class="sec" id="lifecycle" aria-labelledby="lifecycle-title">
      <div class="wrap">
        <div class="shead">
          <p class="eyebrow">{lifecycle.eyebrow}</p>
          <h2 id="lifecycle-title" class="sh">{lifecycle.title}</h2>
          <p class="lead">{lifecycle.lead}</p>
        </div>
        <div class="lc">
          {
            lifecycle.cards.map((card, i) => (
              <article class="lcc">
                <span class="lcc__t">{card.value}</span>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
                <div class="bar" aria-hidden="true">
                  <span style={`width:${LIFECYCLE_BARS[i]}%`} />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="sec sec--alt" id="pricing" aria-labelledby="pricing-title">
      <div class="wrap">
        <div class="shead">
          <p class="eyebrow">{pricing.eyebrow}</p>
          <h2 id="pricing-title" class="sh">{pricing.title}</h2>
          <p class="lead" set:html={rich(pricing.lead)} />
        </div>
        <div class="plans">
          {
            PLANS.map((plan) => (
              <article class:list={["plan", plan.highlight && "plan--hl"]}>
                <h3>{plan.name}</h3>
                <p class="plan__price">{plan.price}</p>
                <ul>
                  {plan.features.map((feature) => <li>{feature}</li>)}
                </ul>
                <a
                  class:list={["btn", plan.highlight && "btn--pri"]}
                  href={"contact" in plan ? CONTACT_URL : API_KEYS_URL}
                >
                  {plan.cta}
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="sec sec--cta" id="start" aria-labelledby="cta-title">
      <div class="wrap">
        <div class="cta">
          <h2 id="cta-title" class="sh">{cta.title}</h2>
          <p set:html={rich(cta.lead)} />
          <div class="cta__actions">
            <a class="btn btn--accent" href={API_KEYS_URL}>{cta.getKey}</a>
            <a class="btn btn--ghost" href={DOCS_URL}>{cta.docs}</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} copy={copy} />
</BaseLayout>
