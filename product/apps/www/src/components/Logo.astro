---
import BoxMascot from "./BoxMascot.astro";

type Props = {
  href: string;
  label: string;
};

const { href, label } = Astro.props;
---

<a class="inline-flex items-center gap-2.5 rounded-lg" href={href} aria-label={label}>
  <BoxMascot size={28} />
  <span class="text-[17px] font-semibold tracking-tight text-foreground" aria-hidden="true">Rookbox</span>
</a>
