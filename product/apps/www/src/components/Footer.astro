---
import type { Copy } from "../i18n/copy";
import type { Locale } from "../i18n/locales";
import { LOCALE_HREFLANG, LOCALE_LABELS, LOCALES, localeHomePath } from "../i18n/locales";
import { LEGAL_LINE } from "../placeholders";
import {
  API_REFERENCE_URL,
  CHANGELOG_URL,
  DOCS_URL,
  PRIVACY_URL,
  ROOK_URL,
  STATUS_URL,
  TERMS_URL,
} from "../site";
import Logo from "./Logo.astro";

type Props = {
  locale: Locale;
  copy: Copy;
};

const { locale, copy } = Astro.props;
const f = copy.footer;

const columns = [
  {
    heading: f.product,
    links: [
      { href: "#demo", label: f.howItWorks },
      { href: "#pricing", label: f.pricing },
      { href: STATUS_URL, label: f.status },
    ],
  },
  {
    heading: f.developers,
    links: [
      { href: DOCS_URL, label: f.docs },
      { href: API_REFERENCE_URL, label: f.api },
      { href: CHANGELOG_URL, label: f.changelog },
    ],
  },
  {
    heading: f.company,
    links: [
      { href: ROOK_URL, label: f.rook },
      { href: PRIVACY_URL, label: f.privacy },
      { href: TERMS_URL, label: f.terms },
    ],
  },
];
---

<footer class="foot">
  <div class="wrap">
    <div class="foot__grid">
      <div class="foot__brand">
        <Logo href={localeHomePath(locale)} label={copy.nav.home} size={28} />
        <p>{f.tagline} <a class="foot__rook" href={ROOK_URL}>{f.rook}</a>.</p>
        <nav class="foot__langs" aria-label={f.languages}>
          {
            LOCALES.map((item) => (
              <a
                href={localeHomePath(item)}
                hreflang={LOCALE_HREFLANG[item]}
                aria-current={item === locale ? "page" : undefined}
              >
                {LOCALE_LABELS[item]}
              </a>
            ))
          }
        </nav>
      </div>
      <nav class="foot__cols" aria-label={f.nav}>
        {
          columns.map((column) => (
            <div class="foot__col">
              <h2>{column.heading}</h2>
              {column.links.map((link) => <a href={link.href}>{link.label}</a>)}
            </div>
          ))
        }
      </nav>
    </div>
    <p class="fine foot__legal">{LEGAL_LINE}</p>
  </div>
</footer>
