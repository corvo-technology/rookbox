---
import type { Copy } from "../i18n/copy";
import type { Locale } from "../i18n/locales";
import { LOCALE_HREFLANG, LOCALE_LABELS, LOCALES, localeHomePath } from "../i18n/locales";
import { DASHBOARD_URL, SITE_NAME } from "../site";
import Logo from "./Logo.astro";

type Props = {
  locale: Locale;
  copy: Copy;
};

const { locale, copy } = Astro.props;
const f = copy.footer;
// Computed at build time.
const year = new Date().getFullYear();

const columns = [
  {
    heading: f.product,
    links: [
      { href: "#how", label: f.howItWorks },
      { href: "#desktop", label: f.desktop },
      { href: "#lifecycle", label: f.lifecycle },
      { href: DASHBOARD_URL, label: f.dashboard },
    ],
  },
  {
    heading: f.developers,
    links: [
      { href: "#start", label: f.quickstart },
      { href: "#e2b", label: f.e2b },
    ],
  },
];
---

<footer class="foot">
  <div class="wrap">
    <div class="foot__grid">
      <div class="foot__brand">
        <Logo href={localeHomePath(locale)} label={copy.nav.home} size={28} />
        <p>
          {f.tagline}
        </p>
        <nav class="foot__langs" aria-label={f.languages}>
          {
            LOCALES.map((item) => (
              <a
                href={localeHomePath(item)}
                hreflang={LOCALE_HREFLANG[item]}
                aria-current={item === locale ? "page" : undefined}
              >
                {LOCALE_LABELS[item]}
              </a>
            ))
          }
        </nav>
      </div>
      <nav class="foot__cols" aria-label={f.nav}>
        {
          columns.map((column) => (
            <div class="foot__col">
              <h2>{column.heading}</h2>
              {column.links.map((link) => <a href={link.href}>{link.label}</a>)}
            </div>
          ))
        }
      </nav>
    </div>
    <p class="fine foot__legal">© {year} {SITE_NAME}</p>
  </div>
</footer>
