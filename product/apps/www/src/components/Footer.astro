---
import type { Copy } from "../i18n/copy";
import type { Locale } from "../i18n/locales";
import { LOCALE_HREFLANG, LOCALE_LABELS, LOCALES, localeHomePath } from "../i18n/locales";
import {
  ABOUT_URL,
  CHANGELOG_URL,
  DASHBOARD_URL,
  DOCS_URL,
  PRICING_URL,
  PRIVACY_URL,
  TERMS_URL,
} from "../site";
import Logo from "./Logo.astro";

type Props = {
  locale: Locale;
  copy: Copy;
};

const { locale, copy } = Astro.props;

const columns = [
  {
    heading: copy.footer.product,
    links: [
      { href: DOCS_URL, label: copy.nav.docs },
      { href: PRICING_URL, label: copy.nav.pricing },
      { href: CHANGELOG_URL, label: copy.nav.changelog },
      { href: DASHBOARD_URL, label: copy.nav.dashboard },
    ],
  },
  {
    heading: copy.footer.company,
    links: [
      { href: ABOUT_URL, label: copy.footer.about },
      { href: PRIVACY_URL, label: copy.footer.privacy },
      { href: TERMS_URL, label: copy.footer.terms },
    ],
  },
];
---

<footer class="mt-24 grid gap-10 border-t border-border py-12 md:grid-cols-[1fr_auto]">
  <div class="flex flex-col items-start gap-5">
    <Logo href={localeHomePath(locale)} label={copy.nav.home} />
    <nav class="flex flex-wrap gap-x-4 gap-y-2" aria-label={copy.footer.languages}>
      {
        LOCALES.map((item) => (
          <a
            href={localeHomePath(item)}
            hreflang={LOCALE_HREFLANG[item]}
            aria-current={item === locale ? "page" : undefined}
            class="text-sm text-muted-foreground transition-colors duration-150 hover:text-foreground aria-[current=page]:text-foreground"
          >
            {LOCALE_LABELS[item]}
          </a>
        ))
      }
    </nav>
    <span class="text-sm text-faint-foreground">© 2026 Rook Box</span>
  </div>
  <nav class="flex gap-16" aria-label={copy.footer.nav}>
    {
      columns.map((column) => (
        <div>
          <h2 class="text-sm font-medium text-foreground">{column.heading}</h2>
          <ul class="mt-3 flex flex-col gap-2 p-0">
            {column.links.map((link) => (
              <li class="list-none">
                <a
                  class="text-sm text-muted-foreground transition-colors duration-150 hover:text-foreground"
                  href={link.href}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
</footer>
