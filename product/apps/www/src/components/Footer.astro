---
import type { Copy } from "../i18n/copy";
import type { Locale } from "../i18n/locales";
import { localeHomePath } from "../i18n/locales";
import { docsUrl, SITE_NAME } from "../site";
import Logo from "./Logo.astro";

type Props = {
  locale: Locale;
  copy: Copy;
};

const { locale, copy } = Astro.props;
// Computed at build time.
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap foot__row">
    <Logo href={localeHomePath(locale)} label={copy.nav.home} size={20} />
    <p class="foot__tag">{copy.footer.tagline}</p>
    <a class="foot__link" href={docsUrl(locale)} rel="noopener">{copy.footer.docs}</a>
    <p class="foot__legal">© {year} {SITE_NAME}</p>
  </div>
</footer>
