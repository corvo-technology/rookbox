---
import type { Copy } from "../i18n/copy";
import type { Locale } from "../i18n/locales";
import { DASHBOARD_URL, WAITLIST_URL } from "../site";

type Props = {
  copy: Copy["waitlist"];
  locale: Locale;
  /** Makes the field ids unique when the form appears twice. */
  id: string;
  /** `dark` for the dark call-to-action band. */
  tone?: "light" | "dark";
};

const { copy, locale, id, tone = "light" } = Astro.props;
// Stable English values go to the API; only the labels change with the language.
const VALUES = ["browser or computer use", "code execution", "long-running background agents", "parallel experiments"];
---

<div class={`wl wl--${tone}`} data-waitlist-root>
  <form
    class="wl__form"
    method="post"
    action={WAITLIST_URL}
    data-waitlist={WAITLIST_URL}
    data-locale={locale}
    data-sending={copy.sending}
    data-ok-body={copy.okBody}
    data-followup-thanks={copy.followup.thanks}
    data-followup-error={copy.followup.error}
    data-error-invalid={copy.errorInvalid}
    data-error-rate={copy.errorRate}
    data-error-generic={copy.errorGeneric}
    novalidate
  >
    <div class="wl__row">
      <label class="sr-only" for={`${id}-email`}>{copy.label}</label>
      <input
        class="wl__input"
        id={`${id}-email`}
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        autocapitalize="off"
        spellcheck="false"
        maxlength="254"
        required
        placeholder={copy.placeholder}
        aria-describedby={`${id}-status`}
      />
      <button class="btn wl__submit" type="submit" data-submit>{copy.submit}</button>
    </div>
    <div class="wl__hp" aria-hidden="true">
      <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <p class="wl__error" id={`${id}-status`} role="alert" data-error hidden></p>
    <p class="wl__fine">{copy.fine}</p>
  </form>
  <div class="wl__done" data-done tabindex="-1" hidden>
    <p class="wl__done-title">{copy.okTitle}</p>
    <p class="wl__done-body" data-done-body></p>
    <div class="wl__follow" data-followup>
      <p class="wl__ask">{copy.followup.prompt} <span class="wl__hint">{copy.followup.hint}</span></p>
      <div class="wl__chips">
        {
          copy.followup.options.map((label, i) => (
            <button class="wl__pick" type="button" data-pick={VALUES[i]}>
              {label}
            </button>
          ))
        }
      </div>
    </div>
    <p class="wl__thanks" data-thanks role="status" hidden></p>
  </div>
  {
    tone === "light" && (
      <a class="wl__login" href={DASHBOARD_URL}>
        {copy.haveAccount}
      </a>
    )
  }
</div>
