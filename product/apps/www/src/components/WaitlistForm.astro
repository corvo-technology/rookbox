---
import type { Copy } from "../i18n/copy";
import type { Locale } from "../i18n/locales";
import { WAITLIST_URL } from "../site";

type Props = {
  copy: Copy["waitlist"];
  locale: Locale;
  /** Makes the field ids unique when the form appears twice. */
  id: string;
  /** `dark` on the near-black hero. */
  tone?: "light" | "dark";
};

const { copy, locale, id, tone = "light" } = Astro.props;
---

<div class={`wl wl--${tone}`} data-waitlist-root>
  <form
    class="wl__form"
    method="post"
    action={WAITLIST_URL}
    data-waitlist={WAITLIST_URL}
    data-locale={locale}
    data-sending={copy.sending}
    data-error-invalid={copy.errorInvalid}
    data-error-rate={copy.errorRate}
    data-error-generic={copy.errorGeneric}
    novalidate
  >
    <div class="wl__row">
      <label class="sr-only" for={`${id}-email`}>{copy.label}</label>
      <input
        class="wl__input"
        id={`${id}-email`}
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        autocapitalize="off"
        spellcheck="false"
        maxlength="254"
        required
        placeholder={copy.placeholder}
        aria-describedby={`${id}-status`}
      />
      <button class="btn wl__submit" type="submit" data-submit>{copy.submit}</button>
    </div>
    <div class="wl__hp" aria-hidden="true">
      <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <p class="wl__error" id={`${id}-status`} role="alert" data-error hidden></p>
  </form>
  <p class="wl__done" data-done tabindex="-1" hidden>{copy.ok}</p>
</div>
