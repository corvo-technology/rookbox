---
import type { Copy } from "../i18n/copy";
import Castle from "./Castle.astro";

type Props = { copy: Copy["visual"] };
const { copy } = Astro.props;
---

<figure class="rook" data-rook data-waiting={copy.waiting} data-ready={copy.ready}>
  <script is:inline>
    // Dim the castle before first paint so it can boot; with reduced motion it stays fully lit.
    try {
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.currentScript.parentElement.setAttribute("data-js", "");
      }
    } catch (e) {}
  </script>
  <Castle label={copy.label} />
  <figcaption class="rook__state mono" aria-live="polite">
    <span class="rook__dot" aria-hidden="true"></span><span data-rook-state>{copy.waiting}</span>
  </figcaption>
</figure>
