# Copy to apps/api/.env and fill in. Never commit the real file.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres, for example a throwaway one: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=rookbox postgres:17
DATABASE_URL=postgresql://postgres:rookbox@127.0.0.1:5432/postgres
RUN_MIGRATIONS=true

# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
APP_ORIGIN=http://127.0.0.1:5173
#
# The session cookie is host-only: sent to the API's own host and nowhere else. Leave COOKIE_DOMAIN
# unset. DANGER: setting it (for example .rookbox.run) sends the login cookie to every subdomain,
# including the machine hosts where other people run web servers.
# COOKIE_DOMAIN=
# Proxies between the internet and the API (X-Forwarded-For is ignored at 0). Set it in production.
TRUSTED_PROXY_HOPS=0

# The desktop's own origin (the API must answer on this host too), and the key that signs desktop
# links: openssl rand -base64 32. Unset DESKTOP_HOST in development: the API serves the desktop itself.
# DESKTOP_HOST=desk.example.test
# DESKTOP_LINK_SECRET=
# DESKTOP_LINK_SECRET_PREVIOUS=
# DESKTOP_LINK_TTL_S=120
# DESKTOP_SESSION_TTL_S=14400

# Who may call the admin procedures (default: the first ROOKBOX_ALLOWED_EMAILS entry).
# ROOKBOX_ADMIN_EMAILS=

# Who may have an account (comma-separated). Sign-up over HTTP is always closed.
ROOKBOX_ALLOWED_EMAILS=owner@example.test
# 12+ characters. Creates the owner account at the first start; remove it afterwards.
# ROOKBOX_SEED_OWNER_PASSWORD=

# The machine service (an E2B-compatible API) and its service key. Server side only.
SPACE_ECW_API_URL=https://api.box.example.test
SPACE_ECW_API_KEY=
E2B_DOMAIN=box.example.test
# Templates people may create machines from, in the order the dashboard offers them.
SPACE_TEMPLATES=desktop,corvo-computer,seed
# How long to wait on a call that waits on a VM (create, suspend, restore, fork), 5000 to 300000 ms.
SPACE_TIMEOUT_MS=60000

# Failed sign-ins allowed per email and per address within the window (seconds).
SIGNIN_MAX_ATTEMPTS=5
SIGNIN_WINDOW_S=600

# Idle seconds before a machine suspends itself, and the most machines one account may hold.
MACHINE_IDLE_TIMEOUT_S=900
MAX_MACHINES_PER_USER=10
# New machines get open internet. The host's own default is closed (no DNS, no internet).
MACHINE_ALLOW_INTERNET=true

# Per-route request limits: user=<max>/<seconds>,ip=<max>/<seconds> (a scope or the whole value can
# be "off"). The defaults are shown. Set RATE_LIMITS_ENABLED=false to switch them all off.
# RATE_LIMITS_ENABLED=true
# RATE_LIMIT_MACHINE_CREATE=user=20/3600,ip=60/3600
# RATE_LIMIT_MACHINE_DELETE=user=40/600,ip=120/600
# RATE_LIMIT_MACHINE_FORK=user=20/3600,ip=60/3600
# RATE_LIMIT_MACHINE_LIFECYCLE=user=60/600,ip=180/600
# RATE_LIMIT_MACHINE_EXEC=user=120/60,ip=300/60
# RATE_LIMIT_API_KEY_CREATE=user=10/3600,ip=30/3600
# RATE_LIMIT_DESKTOP_LINK=user=30/600,ip=90/600
# RATE_LIMIT_AUTH=ip=60/600
# Most bytes of stdout and of stderr that machines.exec returns (1024 to 1048576).
# EXEC_MAX_OUTPUT_BYTES=262144

# Reconciler (machines on the host vs. database rows). Off at 0; reports only unless RECONCILE_ACT.
# Deleting machines that have no row also needs RECONCILE_KILL_ORPHANS=true. See DEPLOY.md.
# RECONCILE_INTERVAL_S=0
# RECONCILE_ACT=false
# RECONCILE_KILL_ORPHANS=false
# RECONCILE_STUCK_AFTER_S=600
# RECONCILE_ORPHAN_GRACE_S=900
