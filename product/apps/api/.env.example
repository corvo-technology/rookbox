# Copy to apps/api/.env and fill in. Never commit the real file.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres, for example a throwaway one: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=rookbox postgres:17
DATABASE_URL=postgresql://postgres:rookbox@127.0.0.1:5432/postgres
RUN_MIGRATIONS=true

# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
APP_ORIGIN=http://127.0.0.1:5173
# Production only: the parent domain shared by the app and the API, for example .rookbox.run
# COOKIE_DOMAIN=

# Who may have an account (comma-separated). Sign-up over HTTP is always closed.
ROOKBOX_ALLOWED_EMAILS=owner@example.test
# 12+ characters. Creates the owner account at the first start; remove it afterwards.
# ROOKBOX_SEED_OWNER_PASSWORD=

# The machine service (an E2B-compatible API) and its service key. Server side only.
SPACE_ECW_API_URL=https://api.box.example.test
SPACE_ECW_API_KEY=
E2B_DOMAIN=box.example.test
# Templates people may create machines from, in the order the dashboard offers them.
SPACE_TEMPLATES=desktop,corvo-computer,seed
# How long to wait on a call that waits on a VM (create, suspend, restore, fork), 5000 to 300000 ms.
SPACE_TIMEOUT_MS=60000

# Failed sign-ins allowed per email and per address within the window (seconds).
SIGNIN_MAX_ATTEMPTS=5
SIGNIN_WINDOW_S=600

# Idle seconds before a machine suspends itself, and the most machines one account may hold.
MACHINE_IDLE_TIMEOUT_S=900
MAX_MACHINES_PER_USER=10
