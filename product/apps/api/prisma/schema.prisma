generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// better-auth tables (email and password only).
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  /// Set by `user:disable`: the account cannot sign in and its sessions and keys stop working.
  disabledAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  apiKeys       ApiKey[]
  machines      Machine[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// A Rookbox API key. Only the SHA-256 of the secret is stored.
model ApiKey {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// First characters of the secret, to tell keys apart.
  hint       String
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
  @@map("api_key")
}

/// A machine a user owns. The id is the SPACE sandbox id. SPACE holds the state; this row holds
/// ownership, the name, the lineage and an in-flight operation, which SPACE cannot report.
model Machine {
  id        String    @id
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  template  String
  vcpu      Int
  memoryMib Int
  diskMib   Int
  /// Seconds without activity before SPACE suspends the machine.
  idleTimeoutS Int @default(900)
  forkedFrom String?
  /// `suspending`, `restoring` or `deleting` while that call is in flight.
  op        String?
  opAt      DateTime?
  createdAt DateTime  @default(now())

  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("machine")
}

/// One thing the usage reporter saw happen to a machine. Append-only; `idempotencyKey` makes a
/// repeated delivery a no-op. Amounts are in integer units (MiB, vCPUs).
model UsageEvent {
  id               Int      @id @default(autoincrement())
  reporterId       String
  /// The reporter's own sequence number; only ever grows.
  seq              Int
  idempotencyKey   String   @unique
  /// `seen`, `resumed`, `suspended`, `resized` or `gone`.
  type             String
  machineId        String
  observedAt       DateTime
  receivedAt       DateTime @default(now())
  /// The state after the event: `running` or `suspended`. Null for `gone`.
  state            String?
  /// The `rookbox.owner` tag at that moment, when the machine had one.
  ownerTag         String?
  template         String
  vcpu             Int
  memoryMib        Int
  diskMib          Int
  machineStartedAt DateTime?
  /// `reporter` for an event the reporter sent, `snapshot` for one made from a snapshot.
  source           String   @default("reporter")

  @@index([machineId, observedAt])
  @@index([reporterId, machineId])
  @@map("usage_event")
}

/// A stretch of time a machine spent in one state at one size, derived from its events and
/// rebuilt whenever one arrives. `endedAt` is null while it is still open. No FK to the user:
/// usage outlives an account.
model UsageInterval {
  id          Int       @id @default(autoincrement())
  machineId   String
  /// Null for machines with no known owner (the "unassigned" bucket, visible to admins only).
  ownerUserId String?
  template    String
  vcpu        Int
  memoryMib   Int
  diskMib     Int
  /// `running` or `suspended`.
  state       String
  startedAt   DateTime
  endedAt     DateTime?
  /// Whole seconds from `startedAt` to `endedAt`; null while open.
  seconds     Int?

  @@index([machineId])
  @@index([ownerUserId, startedAt])
  @@index([endedAt])
  @@map("usage_interval")
}

/// One row per usage reporter: when it last got through, for the admin's "gone quiet" check.
model UsageReporter {
  id            String    @id
  lastContactAt DateTime
  lastEventAt   DateTime?
  lastSeq       Int       @default(0)
  /// How often the reporter looks at machines, in seconds.
  pollIntervalS Int       @default(30)

  @@map("usage_reporter")
}
